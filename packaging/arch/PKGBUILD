# Maintainer: metalgrid
# Builds the master branch from GitHub. For local development builds,
# point the source at your checkout: git+file:///path/to/zdr#branch=master
pkgname=zdr
pkgver=0.1.0
pkgrel=1
pkgdesc="Face-only Linux authentication with IR liveness and explicit consent (PAM + daemon + session agent)"
arch=('x86_64')
url="https://github.com/metalgrid/zdr"
license=('MIT')
depends=('pam' 'dbus' 'gcc-libs' 'glibc')
makedepends=('cargo' 'rust' 'git' 'qt6-declarative')
optdepends=('qt6-declarative: QtQuick consent prompt'
            'layer-shell-qt: overlay layer for the QtQuick prompt'
            'v4l-utils: camera inspection'
            'pamtester: test the PAM stack before enabling it')
install=zdr.install
source=("$pkgname::git+https://github.com/metalgrid/zdr.git#branch=master"
        "face_detection_yunet_2023mar.onnx::https://media.githubusercontent.com/media/opencv/opencv_zoo/main/models/face_detection_yunet/face_detection_yunet_2023mar.onnx"
        "face_recognition_sface_2021dec.onnx::https://media.githubusercontent.com/media/opencv/opencv_zoo/main/models/face_recognition_sface/face_recognition_sface_2021dec.onnx")
sha256sums=('SKIP'
            '8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4'
            '0ba9fbfa01b5270c96627c4ef784da859931e02f04419c829e83484087c34e79')

build() {
    cd "$srcdir/$pkgname"
    # The ort crate downloads a prebuilt ONNX Runtime on first build,
    # so this step needs network access.
    cargo build --release --locked --workspace

    # Optional zdr-prompt QtQuick host (plain window). main.cpp uses
    # LayerShellQt automatically via __has_include when its headers
    # are present at build time; link it only in that case. This is
    # deliberately not a hard dependency: without Qt at runtime the
    # host simply fails its --probe and zdr-agent falls back to
    # qml6 / desktop notifications.
    local layershell_libs=''
    if test -f /usr/include/LayerShellQt/Window.h; then
        layershell_libs='-lLayerShellQtInterface'
    fi
    g++ -std=c++17 -fPIC -O2 zdr-agent/prompt/main.cpp -o zdr-prompt \
        $(pkg-config --cflags --libs Qt6Quick Qt6Gui Qt6Qml Qt6Core) \
        $layershell_libs

    # Optional zdr-enroll GUI (Qt6 + QtDBus; needs moc for its backend
    # QObject). Same optional-at-runtime shape as the prompt host:
    # built when qt6-declarative is present at build time (makedepends),
    # useless-but-harmless on a Qt-less system.
    mkdir -p zdr-enroll-build
    /usr/lib/qt6/moc zdr-enroll/main.cpp -o zdr-enroll-build/main.moc
    g++ -std=c++17 -fPIC -O2 -Izdr-enroll-build zdr-enroll/main.cpp -o zdr-enroll-bin \
        $(pkg-config --cflags --libs Qt6Quick Qt6Gui Qt6Qml Qt6Core Qt6DBus) \
        $layershell_libs
}

check() {
    cd "$srcdir/$pkgname"
    cargo test --release --locked --workspace
}

package() {
    cd "$srcdir/$pkgname"
    install -Dm755 target/release/zdrd "$pkgdir/usr/bin/zdrd"
    install -Dm755 target/release/zdr-agent "$pkgdir/usr/bin/zdr-agent"
    install -Dm755 target/release/zdrctl "$pkgdir/usr/bin/zdrctl"
    install -Dm755 target/release/libpam_zdr.so "$pkgdir/usr/lib/security/pam_zdr.so"
    install -Dm755 zdr-prompt "$pkgdir/usr/lib/zdr/zdr-prompt"
    install -Dm644 zdr-agent/prompt/zdr-prompt.qml \
        "$pkgdir/usr/share/zdr/zdr-prompt.qml"
    install -Dm755 zdr-enroll-bin "$pkgdir/usr/bin/zdr-enroll"
    install -Dm644 zdr-enroll/zdr-enroll.qml \
        "$pkgdir/usr/share/zdr/zdr-enroll.qml"
    install -Dm644 zdr-enroll/zdr-enroll.desktop \
        "$pkgdir/usr/share/applications/zdr-enroll.desktop"
    install -Dm644 packaging/polkit/org.zdr.Authenticator.policy \
        "$pkgdir/usr/share/polkit-1/actions/org.zdr.Authenticator.policy"

    install -Dm644 "$srcdir/face_detection_yunet_2023mar.onnx" \
        "$pkgdir/usr/share/zdr/models/face_detection_yunet_2023mar.onnx"
    install -Dm644 "$srcdir/face_recognition_sface_2021dec.onnx" \
        "$pkgdir/usr/share/zdr/models/face_recognition_sface_2021dec.onnx"

    install -Dm644 dbus-1/org.zdr.Authenticator.conf \
        "$pkgdir/usr/share/dbus-1/system.d/org.zdr.Authenticator.conf"
    install -Dm644 packaging/arch/org.zdr.Authenticator.service \
        "$pkgdir/usr/share/dbus-1/system-services/org.zdr.Authenticator.service"
    install -Dm644 packaging/arch/zdrd.service \
        "$pkgdir/usr/lib/systemd/system/zdrd.service"
    install -Dm644 packaging/arch/zdr-agent.desktop \
        "$pkgdir/etc/xdg/autostart/zdr-agent.desktop"
    install -Dm644 packaging/arch/zdr.tmpfiles \
        "$pkgdir/usr/lib/tmpfiles.d/zdr.conf"
    install -Dm644 zdrd/zdrd.toml.example "$pkgdir/etc/zdr/zdrd.toml"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
