[Unit]
Description=zdr face authentication daemon
After=dbus.service

[Service]
Type=dbus
BusName=org.zdr.Authenticator
ExecStart=/usr/bin/zdrd --config /etc/zdr/zdrd.toml
StateDirectory=zdr
StateDirectoryMode=0700
Restart=on-failure
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/zdr

[Install]
WantedBy=multi-user.target
