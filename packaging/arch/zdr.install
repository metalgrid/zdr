post_install() {
    echo ">>> zdr installed. Next steps:"
    echo ">>> 1. Start the daemon:  systemctl enable --now zdrd.service"
    echo ">>> 2. Enroll IR templates for your user:"
    echo ">>>      install -d -m700 /var/lib/zdr/\$USER"
    echo ">>>      Copy 3-5 IR captures named ir*.png into that directory."
    echo ">>>    Guided, quality-checked enrollment: sudo zdrctl enroll"
    echo ">>> 3. Enable the session agent: systemctl --user enable --now zdr-agent.service"
    echo ">>>    It refuses to run as root / as a system service, by design."
    echo ">>> 4. Test with pamtester BEFORE touching a real service."
    echo ">>> 5. Only then add as the FIRST line of /etc/pam.d/sudo:"
    echo ">>>      auth sufficient pam_zdr.so"
    echo ">>>    Keep a root shell open while you test. Face failure must"
    echo ">>>    fall through to the password prompt."
}

post_upgrade() {
    echo ">>> zdr upgraded. Restart the daemon: systemctl restart zdrd.service"
}
