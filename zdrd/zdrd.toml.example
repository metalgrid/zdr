# zdrd configuration — copy to /etc/zdr/zdrd.toml and edit.
# Every key is optional. Precedence: CLI flag > this file > built-in default.
# A present but invalid file makes the daemon refuse to start.

# RGB camera device (e.g. /dev/v4l/by-path/...), or "auto" to detect.
#rgb_camera = "auto"

# IR camera device (e.g. /dev/v4l/by-path/...), or "auto" to detect.
#ir_camera = "auto"

# WARNING: setting require_ir = false selects RGB-only mode.
# A printed photo or a photo on a phone screen can pass in this mode.
# It is convenience only, not secure authentication. Keep this true
# (the default) unless you accept that risk.
#require_ir = true

# Cosine-similarity match threshold.
#threshold = 0.363

# Directory holding per-user templates: <auth_dir>/<user>/templates.bin
#auth_dir = "/var/lib/zdr"

# TPM PCRs the sealed login password (Step 15, password.cred) is bound
# to, as a "+"-separated list such as "7" or "7+11". Default is "7"
# (Secure Boot state). Set to "" for no PCR binding: the daemon then
# omits --tpm2-pcrs entirely (systemd-creds 262 accepts an empty
# --tpm2-pcrs= value when encrypting, but the resulting credential
# cannot be decrypted again, so an empty value is never passed).
#tpm_pcrs = "7"

# Path to the YuNet face-detection ONNX model.
#yunet = "/usr/share/zdr/models/face_detection_yunet_2023mar.onnx"

# Path to the SFace face-recognition ONNX model.
#sface = "/usr/share/zdr/models/face_recognition_sface_2021dec.onnx"
